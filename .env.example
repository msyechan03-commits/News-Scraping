# Salin jadi .env lalu isi nilainya. JANGAN commit .env (sudah di .gitignore).

# === Model (OpenRouter, Gemini 2.5 Flash) ===
OPENROUTER_API_KEY=

# === Click n Read (e-paper koran) ===
CNR_USERNAME=
CNR_PASSWORD=

# === Supabase ===
# Project Settings > API
SUPABASE_URL=https://jzcmkkswkxjzxzdzffmb.supabase.co
# service_role: HANYA untuk pipeline dan backend. Jangan pernah ke frontend.
SUPABASE_SERVICE_ROLE_KEY=
# anon public: untuk dashboard membaca. Boleh dipakai di frontend.
SUPABASE_ANON_KEY=

# === WhatsApp Business API ===
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_RECIPIENT=

# === Opsional ===
# Second Brain belum dimigrasi ke OpenRouter, masih butuh ANTHROPIC_API_KEY.
ENABLE_SECOND_BRAIN=false
ANTHROPIC_API_KEY=
